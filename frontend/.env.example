# Frontend build-time settings (no secrets belong here; they would be public).
# How often data is refetched while the tab is visible (seconds). Live SSE updates
# trigger refetches sooner; polling is the fallback.
VITE_POLL_INTERVAL_SECONDS=60
# Set to "false" to disable the Server-Sent Events live channel.
VITE_LIVE_UPDATES=true
# --- Dev server proxy targets (server side only: no VITE_ prefix, never in the browser bundle)
# This dashboard's own backend (/api/v1/...).
DASHBOARD_BACKEND_URL=http://127.0.0.1:8100
# AdhyaapakAI backend (/api/... for Voucher Management). LIVE: edits production vouchers.
# Local backend (for development against a laptop backend):
# ADHYAAPAK_BACKEND_URL=http://127.0.0.1:8001
ADHYAAPAK_BACKEND_URL=https://api.adhyaapak.ai

# --- AdhyaapakAI API path the browser calls (relative, through the proxy). Not secret.
VITE_ADHYAAPAK_API_BASE=/api

# NEVER put the AdhyaapakAI admin secret in this file: every VITE_ value is compiled into the
# public JavaScript bundle. The secret is typed into the dashboard's unlock screen instead.
