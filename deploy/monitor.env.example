# API Cost Monitor — PRODUCTION configuration
#
# Installed by `manage.sh setup-host` as /etc/api-cost-monitor/monitor.env (root:root 0600).
# systemd reads it as root before starting the service, so the service account itself can
# never read this file. Edit with:  sudo -e /etc/api-cost-monitor/monitor.env
#
# Format: KEY=value, one per line, no `export`, no spaces around `=`. Quote values that
# contain spaces or '#' with single quotes. Blank value = not set.
#
# Set by the systemd unit, not here: APP_ENV=production, DATABASE_URL, BACKUP_DIR.
# Never put this file in the release, a web root or version control.

# --- Dashboard access (REQUIRED) -------------------------------------------------------
# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing a token signs out every session that was created with it.
DASHBOARD_OWNER_TOKEN=
DASHBOARD_VIEWER_TOKEN=
# Bearer tokens let scripts call the API. The browser UI never needs them.
BEARER_AUTH_ENABLED=false

# --- Address the dashboard is reached at -------------------------------------------------
# Private mode (SSH tunnel, recommended to start): keep the defaults below.
# Public mode (nginx + HTTPS): add your monitoring hostname, e.g. monitor.example.com,
# and set DASHBOARD_URL=https://monitor.example.com
ALLOWED_HOSTS=127.0.0.1,localhost
DASHBOARD_URL=http://localhost:8100
# Same-origin UI needs no CORS. Never '*'.
CORS_ORIGINS=
# Secure cookies are always on in production; leave this commented out.
# SESSION_COOKIE_SECURE=true

# --- Sessions and sign-in limits --------------------------------------------------------
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
SESSION_REMEMBER_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
MAX_REQUEST_BYTES=65536

# --- Display ---------------------------------------------------------------------------
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata
SUPPORTED_CURRENCIES=USD,INR
LOG_LEVEL=INFO
LOG_JSON=true

# --- Monitoring schedule (one scheduler, inside the single uvicorn worker) ----------------
POLLING_ENABLED=true
# Balances and usage. 30 min keeps balances fresh (stale after 2 h for API providers)
# and is far below every provider's rate limit.
POLL_INTERVAL_MINUTES=30
# Public status pages / credential probes.
HEALTH_CHECK_INTERVAL_MINUTES=10
# AWS Cost Explorer: billed at USD 0.01 per request and refreshed by AWS only a few times a
# day. Every 6 h is about 3 requests per sync = ~12 requests/day (~USD 3.60/month).
AWS_COST_EXPLORER_INTERVAL_MINUTES=360
USAGE_LOOKBACK_DAYS=31
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
OPERATION_TIMEOUT_SECONDS=120
# Comma-separated provider ids to switch off entirely (openai,sarvam,deepgram,elevenlabs,aws)
DISABLED_PROVIDERS=

# --- Provider credentials (read-only / billing-read keys only) ---------------------------
# Leave blank to show the provider as "not configured". See docs/SECURITY.md for rotation.
OPENAI_ADMIN_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
ELEVENLABS_API_KEY=
# Sarvam has no billing API: balances are entered manually in the dashboard.

# --- AWS (read-only) ------------------------------------------------------------------------
# Preferred on EC2: attach an instance role with docs/aws-monitoring-iam-policy.json and leave
# the key fields blank (no long-lived keys on disk). Otherwise use a dedicated IAM user with
# only that policy. Never reuse the main application's AWS keys.
AWS_MONITORING_ENABLED=false
AWS_REGIONS=ap-south-1
AWS_COST_EXPLORER_ENABLED=true
AWS_CREDITS_ENABLED=true
AWS_RESOURCES_ENABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# --- Email alerts -------------------------------------------------------------------------
# Off until you have run a controlled test (Thresholds page -> Send test email).
# EC2 blocks outbound port 25: use 587 (STARTTLS) or 465 (SSL).
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=15
ALERT_RECIPIENTS=
ALERT_MAX_DELIVERY_ATTEMPTS=6
ALERT_RETRY_BASE_SECONDS=60
ALERT_RETRY_MAX_SECONDS=3600

# --- Currency conversion for thresholds (optional; never guessed) -------------------------
# Example: EXCHANGE_RATES=USD/INR=83.20   EXCHANGE_RATE_SOURCE='RBI reference rate 2026-10-15'
EXCHANGE_RATES=
EXCHANGE_RATE_SOURCE=

# --- Backups and disk ---------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# /ready reports disk "failed" below this; the health-check timer also warns below 1 GB.
DISK_MIN_FREE_MB=500

# --- Live updates (Server-Sent Events) -------------------------------------------------------
SSE_CHECK_SECONDS=5
SSE_MAX_CONNECTION_SECONDS=300

# --- Voucher management ---------------------------------------------------------------
# Bearer token for YOUR app/scripts to register voucher users and redeem vouchers via
# /api/v1/integrations/vouchers/... It grants nothing else. Empty = integration API off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VOUCHER_API_TOKEN=
# Starting user limit for voucher holders (the owner can change it in the dashboard).
VOUCHER_DEFAULT_USER_LIMIT=1000

# --- Course management ----------------------------------------------------------------
# Bearer token for YOUR app backend (it authenticates students and verifies payments) to
# confirm payments, enroll students and check course access via
# /api/v1/integrations/courses/... It grants nothing else. Empty = course API off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
COURSE_API_TOKEN=
# Private S3 bucket for course files (thumbnails, videos, audio, subtitles, PDFs).
# Use a dedicated IAM user limited to s3:PutObject + s3:GetObject on this bucket (NOT the
# read-only monitoring keys). The bucket needs a CORS rule allowing POST from the dashboard
# origin. Empty bucket = uploads off (lecture video URLs still work).
COURSE_ASSETS_BUCKET=
COURSE_ASSETS_REGION=ap-south-1
# Files go to {prefix}{course_id}/{asset_id}-{file}; videos/ and notes/ are refused.
COURSE_ASSETS_PREFIX=course-assets/
COURSE_ASSETS_ACCESS_KEY_ID=
COURSE_ASSETS_SECRET_ACCESS_KEY=
# Signed URL lifetime (seconds) and upload size limits (MB).
COURSE_ASSETS_URL_TTL_SECONDS=900
COURSE_ASSET_MAX_VIDEO_MB=4096
COURSE_ASSET_MAX_FILE_MB=100

# --- Account deletions (AdhyaapakAI admin API) ------------------------------------------
# This dashboard's server calls the AdhyaapakAI backend with the x-admin-secret header; the
# browser never sees the secret, so no CORS / ALLOWED_ORIGINS change is needed upstream.
# ADHYAAPAK_ADMIN_SECRET must equal the AdhyaapakAI backend's ADMIN_SECRET. Either empty =
# the Account Deletions page shows "not configured". Restart the dashboard after changing.
# Local AdhyaapakAI backend:  http://127.0.0.1:8001   Production: https://api.adhyaapak.ai
ADHYAAPAK_API_BASE_URL=
ADHYAAPAK_ADMIN_SECRET=
