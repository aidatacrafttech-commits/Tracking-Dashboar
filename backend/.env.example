# Copy to backend/.env and fill in locally. Never commit .env.
# Values below are placeholders only.

# --- Application -----------------------------------------------------------
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true                      # JSON logs (recommended); false = human-readable
DOCS_ENABLED=true                  # OpenAPI /docs; forced off when APP_ENV=production

# --- Database ----------------------------------------------------------------
# SQLite file path is relative to the backend/ directory.
DATABASE_URL=sqlite:///./data/monitor.db

# --- Authentication -----------------------------------------------------------
# Owner token: full read/write. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_OWNER_TOKEN=
# Optional read-only token (e.g. for a TV/wallboard). Leave empty to disable.
DASHBOARD_VIEWER_TOKEN=

# --- HTTP -----------------------------------------------------------------------
# Comma-separated list of allowed browser origins for the future dashboard UI.
CORS_ORIGINS=http://localhost:5173

# --- Money and display ------------------------------------------------------------
SUPPORTED_CURRENCIES=USD,INR,EUR,GBP
# IANA timezone used until changed via PUT /api/v1/settings. Storage is always UTC.
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata

# --- Polling -------------------------------------------------------------------------
POLLING_ENABLED=true
POLL_INTERVAL_MINUTES=30            # balance / usage / billing / AWS resources (5-1440)
HEALTH_CHECK_INTERVAL_MINUTES=5     # public status pages and AWS credential probe
AWS_COST_EXPLORER_INTERVAL_MINUTES=360   # >= 60; Cost Explorer bills $0.01 per request
USAGE_LOOKBACK_DAYS=31
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
OPERATION_TIMEOUT_SECONDS=120          # overall time budget per provider operation
# Comma-separated provider ids to switch off entirely, e.g. "sarvam,elevenlabs"
DISABLED_PROVIDERS=

# --- Provider credentials -------------------------------------------------------------
# A provider with missing values shows "not_configured" in the dashboard; nothing crashes.
# OpenAI: an ADMIN key (Settings -> Organization -> Admin keys, created by an Owner).
#   Normal project keys cannot read usage or costs.
OPENAI_ADMIN_KEY=
# Deepgram: key with Owner/Admin role (needs billing:read for balances), plus project id.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
# ElevenLabs: API key with access to user/subscription and usage.
ELEVENLABS_API_KEY=
# Sarvam AI: no key needed; Sarvam has no billing/usage API (enter balance manually).

# --- AWS (read-only; opt-in) ----------------------------------------------------------
AWS_MONITORING_ENABLED=false
# Leave both empty to use the standard chain (AWS_PROFILE, instance role, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGIONS=ap-south-1              # regions for EC2/EBS/S3 metrics (comma-separated)
AWS_COST_EXPLORER_ENABLED=true
AWS_CREDITS_ENABLED=true
AWS_RESOURCES_ENABLED=true
# Least-privilege policy: docs/aws-monitoring-iam-policy.json

# --- Optional: read provider variables from other env files ---------------------------
# Set EXTRA_ENV_FILES as a real environment variable (not in this file), e.g.
#   EXTRA_ENV_FILES=C:\path\to\other-service\.env
# Only the variable names above are read; this file (backend/.env) wins on conflicts.

# --- Alerts and email (Phase 3) ---------------------------------------------------------
# Master switch. While false, low-balance alerts are evaluated and recorded (visible in
# the dashboard) but never emailed. Only POST /api/v1/notifications/test-email can send.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=                          # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls              # starttls (587) | ssl (465) | none (local relay only)
SMTP_USERNAME=
SMTP_PASSWORD=                      # Gmail: an App Password, not your account password
SMTP_FROM=                          # sender address, e.g. alerts@yourdomain.com
SMTP_TIMEOUT_SECONDS=15
ALERT_RECIPIENTS=                   # comma-separated default recipients
DASHBOARD_URL=                      # optional link included in emails
ALERT_MAX_DELIVERY_ATTEMPTS=6
ALERT_RETRY_BASE_SECONDS=60         # backoff: 60s, 120s, 240s ... capped below
ALERT_RETRY_MAX_SECONDS=3600
# Optional currency conversion for threshold comparisons. Without both values, a balance
# in a different currency than its threshold is never compared (no guessing).
EXCHANGE_RATES=                     # e.g. USD/INR=83.25
EXCHANGE_RATE_SOURCE=               # e.g. RBI reference rate 2026-10-12

# --- Dashboard UI (Phase 4) -----------------------------------------------------------
# Built UI served at "/" when this folder exists (default: ../frontend/dist).
# FRONTEND_DIST_DIR=
SSE_CHECK_SECONDS=5                 # how often the live-update stream checks for changes
SSE_MAX_CONNECTION_SECONDS=300      # streams are recycled; browsers reconnect automatically

# --- Security hardening (Phase 5) -------------------------------------------------------
# Browser sessions (HttpOnly cookie, server-side, CSRF-protected).
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
SESSION_REMEMBER_DAYS=7             # "Keep me signed in" lifetime
# SESSION_COOKIE_SECURE=            # empty = Secure in production; force true behind HTTPS
BEARER_AUTH_ENABLED=true            # Authorization: Bearer for scripts; false = sessions only
LOGIN_MAX_FAILURES=5                # per client IP per window (x10 across all IPs)
LOGIN_WINDOW_MINUTES=15
ALLOWED_HOSTS=127.0.0.1,localhost   # Host header allow-list (add your domain when deployed)
MAX_REQUEST_BYTES=65536
# Backups (SQLite online backup + integrity check), retention and disk guard.
# BACKUP_DIR=                       # default backend/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
DISK_MIN_FREE_MB=200

# --- Voucher management ---------------------------------------------------------------
# Bearer token for YOUR app/scripts to register voucher users and redeem vouchers via
# /api/v1/integrations/vouchers/... It grants nothing else. Empty = integration API off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VOUCHER_API_TOKEN=
# Starting user limit for voucher holders (the owner can change it in the dashboard).
VOUCHER_DEFAULT_USER_LIMIT=1000

# --- Course management ----------------------------------------------------------------
# Bearer token for YOUR app backend (it authenticates students and verifies payments) to
# confirm payments, enroll students and check course access via
# /api/v1/integrations/courses/... It grants nothing else. Empty = course API off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
COURSE_API_TOKEN=
# Private S3 bucket for course files (thumbnails, videos, audio, subtitles, PDFs).
# Use a dedicated IAM user limited to s3:PutObject + s3:GetObject on this bucket (NOT the
# read-only monitoring keys). The bucket needs a CORS rule allowing POST from the dashboard
# origin. Empty bucket = uploads off (lecture video URLs still work).
COURSE_ASSETS_BUCKET=
COURSE_ASSETS_REGION=ap-south-1
# Files go to {prefix}{course_id}/{asset_id}-{file}; videos/ and notes/ are refused.
COURSE_ASSETS_PREFIX=course-assets/
COURSE_ASSETS_ACCESS_KEY_ID=
COURSE_ASSETS_SECRET_ACCESS_KEY=
# Signed URL lifetime (seconds) and upload size limits (MB).
COURSE_ASSETS_URL_TTL_SECONDS=900
COURSE_ASSET_MAX_VIDEO_MB=4096
COURSE_ASSET_MAX_FILE_MB=100

# --- App Users (AdhyaapakAI MongoDB, read-only) -------------------------------------------
# The dashboard server reads the app's users, purchases and deletion journal to show daily
# signups; the browser only gets counts and masked rows, and the URL is never logged.
# Use an Atlas database user with ONLY the built-in "read" role on this database, and add
# this server's outbound IP to the Atlas IP access list. Both empty = the App Users page
# shows "not configured". Restart the dashboard after changing.
# e.g. mongodb+srv://dashboard-reader:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
ADHYAAPAK_MONGO_URL=
ADHYAAPAK_MONGO_DB=

# --- Live "Online now" (heartbeats from the AdhyaapakAI mobile app) -------------------------
# The app sends POST /api/v1/integrations/presence/heartbeat every 30 s while it is open,
# signed with the student's login token. Set this to the AdhyaapakAI backend's JWT_SECRET so
# the dashboard can verify those tokens locally. Empty = heartbeats are refused (401) and the
# App Users page shows "Online now (last 15 min)" from recent activity instead.
ADHYAAPAK_JWT_SECRET=
